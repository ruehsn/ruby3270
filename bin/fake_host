#!/usr/bin/env ruby
# frozen_string_literal: true

# A pretend mainframe for testing:  ruby bin/fake_host [port]   (default 3270)
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "tn3270/fake_host"

port = (ARGV.first || 3270).to_i
trap("INT") { exit }
Tn3270::FakeHost.new(port: port).run_forever
